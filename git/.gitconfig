[user]
  name = Joni Hasanen
  useConfigOnly = true

[includeIf "gitdir:~/code/disobeyfi/"]
    path = ~/.gitconfig-disobey

[includeIf "gitdir:~/code/hasanen/"]
    path = ~/.gitconfig-personal

[core]
  editor = vim
  excludesfile = ~/.gitignore_global

[color]
  branch = auto
  diff = auto
  status = auto
  ui = auto

[diff]
  tool = vimdiff
  compactionHeuristic = true

[merge]
  tool = vimdiff

[alias]
  # Will start a repo in this directory
  this = !git init && git add . && git commit -m \"initial commit\"

  # will put a file into gitignore
  ignore = !f() { [ -f .gitignore ] || touch .gitignore; printf '%s\n' "$1" >> .gitignore; }; f
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit

[branch]
  autosetuprebase = always
[commit]
  template = ~/.git-commit-template
[credential]
  helper = osxkeychain
[init]
	defaultBranch = main
[pull]
	rebase = true
