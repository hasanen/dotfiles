#!/bin/bash

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: buildtar folder_to_compress [output_path] [compress_only_contents]" >&2
  exit 1
fi

FOLDER="$1"
if [[ ! -d "$FOLDER" ]]; then
  echo "Error: source directory not found: $FOLDER" >&2
  exit 1
fi

if [[ $# -ge 2 && -n "$2" ]]; then
  FILENAME="$2"
else
  FILENAME="${FOLDER}.tar.gz"
  echo "Using foldername('$FOLDER') as filename('$FILENAME')"
fi

MOVEINTODIR="${3:-}"

if [[ -e "$FILENAME" ]]; then
  echo "Refusing to overwrite existing output: $FILENAME" >&2
  exit 1
fi

printf 'Building tarball...\n'

if [[ -z "$MOVEINTODIR" ]]; then
  tar czf "$FILENAME" --exclude=.git* --exclude=nbproject -- "$FOLDER"
else
  tar czf "$FILENAME" --exclude=.git* --exclude=nbproject -C "$FOLDER" .
fi

